<!doctype html>
<html {% if section %} data-current="{{ section }}"{% endif %} lang="en">

	{% include "components/head.njk" %}

	<body>

		<header class="site-header">
			<style>
    			/* Regole per gli schermi dei telefoni (sotto i 768px) */
    			@media (max-width: 768px) {
        			.fiamma-container { display: none !important; }
        			.titolo-krynn { font-size: 1.5rem !important; margin: 0 0.5rem !important; white-space: normal !important; text-align: center; }
        			.drago-icona { height: 35px !important; }
    			}
			</style>

			<div class="testata-sito" style="display: flex; justify-content: center; align-items: center; width: 100%; box-sizing: border-box; padding: 1.5rem 5%; position: relative; overflow: hidden;">
    
    			<!-- Contenitore invisibile Fiamma Sinistra -->
    			<div class="fiamma-container" style="flex-grow: 1; height: 50px; position: relative; margin-right: 1rem;">
        			<img src="/static/img/wildfires.png" alt="" style="position: absolute; right: 0; top: 0; width: 250px; height: 200px; object-fit: cover; object-position: top; opacity: 0.7;">
    			</div>
    
    			<!-- Drago di Sinistra -->
    			<img class="drago-icona" src="/static/img/drago.png" alt="" style="height: 50px; opacity: 0.8; position: relative; z-index: 2;">
    
    			<h1 class="titolo-krynn" style="margin: 0 1.5rem; white-space: nowrap; position: relative; z-index: 2;">Cronache di Krynn</h1>
    
    			<!-- Drago di Destra (Specchiato) -->
    			<img class="drago-icona" src="/static/img/drago.png" alt="" style="height: 50px; opacity: 0.8; transform: scaleX(-1); position: relative; z-index: 2;">
    
    			<!-- Contenitore invisibile Fiamma Destra -->
    			<div class="fiamma-container" style="flex-grow: 1; height: 50px; position: relative; margin-left: 1rem;">
        			<img src="/static/img/wildfires.png" alt="" style="position: absolute; left: 0; top: 0; transform: scaleX(-1); width: 250px; height: 200px; object-fit: cover; object-position: top; opacity: 0.7;">
    			</div>
			</div>
 			 <nav class="nav-dragonlance">
   				 <ul>
   					 <li><a href="/">Home</a></li>
	   				 <li><a href="/diario/">Diario di Campagna</a></li>
	  				 <li><a href="/personaggi/">Dramatis Personae</a></li>
  					 <li><a href="/mappe/">Atlante di Krynn</a></li>
				 </ul>
 			 </nav>
		</header>

		<main>
			{{ content | safe }}
		</main>

		{% include "components/footer.njk" %}

	</body>

</html>
