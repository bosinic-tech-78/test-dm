---
layout: layouts/base.njk
---
<article class="pergamena-container">
  <header>
    <h1>{{ title }}</h1>
    <p><em>Data sessione: {{ date }}</em></p>
  </header>
  
  <div class="testo-capitolo">
    {{ content | safe }}
    <hr style="border: 0; border-top: 2px solid #8b5a2b; margin: 3rem 0 1.5rem 0; opacity: 0.5;">
    
    <div style="display: flex; justify-content: space-between; align-items: center; font-weight: bold; font-size: 1.1rem;">
      
      <!-- Freccia Sinistra (Capitolo Precedente) -->
      {% set capitoloPrecedente = collections.diario | getPreviousCollectionItem(page) %}
      {% if capitoloPrecedente %}
        <a href="{{ capitoloPrecedente.url }}" style="text-decoration: none; color: #4a2f1d; background: rgba(255,255,255,0.4); padding: 0.5rem 1rem; border-radius: 4px; border: 1px solid #8b5a2b;">
          &larr; {{ capitoloPrecedente.data.title }}
        </a>
      {% else %}
        <span></span> <!-- Spazio vuoto se è il primo capitolo -->
      {% endif %}

      <!-- Freccia Destra (Capitolo Successivo) -->
      {% set capitoloSuccessivo = collections.diario | getNextCollectionItem(page) %}
      {% if capitoloSuccessivo %}
        <a href="{{ capitoloSuccessivo.url }}" style="text-decoration: none; color: #4a2f1d; background: rgba(255,255,255,0.4); padding: 0.5rem 1rem; border-radius: 4px; border: 1px solid #8b5a2b;">
          {{ capitoloSuccessivo.data.title }} &rarr;
        </a>
      {% else %}
        <span></span> <!-- Spazio vuoto se è l'ultimo capitolo -->
      {% endif %}
      
    </div>
  </div>
</article>
